{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "order-service",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "kitchens": {
        "ClusterId": "kitchen-service",
        "Match": {
          "Path": "/api/kitchens/{**catch-all}"
        }
      },
      "delivery": {
        "ClusterId": "delivery-service",
        "Match": {
          "Path": "/api/delivery/{**catch-all}"
        }
      },
      "analytics": {
        "ClusterId": "analytics-service",
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "order-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "kitchen-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "delivery-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "analytics-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
